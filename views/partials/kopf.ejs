<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="CineRate: Filme bewerten, Watchlist führen, Empfehlungen entdecken" />
  <title><%= titel %> – CineRate</title>
  <link rel="icon" href="data:," />
  <link rel="stylesheet" href="/style.css" />
</head>

<body>
  <header class="kopf">
    <div class="kopf-innen">
      <a class="logo" href="/">CineRate</a>
      <nav class="navigation" aria-label="Hauptnavigation">
        <% menue.forEach((punkt) => { %>
          <a href="<%= punkt.pfad %>"<% if (punkt.pfad === aktuellerPfad) { %> class="aktiv"<% } %>><%= punkt.text %></a>
        <% }) %>
      </nav>
    </div>
  </header>

  <main class="inhalt">